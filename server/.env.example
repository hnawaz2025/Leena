DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leena"
PORT=4000

# AI_LLM_PROVIDER: "anthropic" (default) or "featherless"
AI_LLM_PROVIDER=anthropic
AI_SPEECH_PROVIDER=openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only needed when AI_LLM_PROVIDER=featherless. Get FEATHERLESS_API_KEY from
# https://featherless.ai. FEATHERLESS_MODEL must be an exact model id from
# their catalogue -- verify it exists via GET https://api.featherless.ai/v1/models
# (many plausible-looking ids, e.g. Meta-Llama models, are gated or don't exist).
# Also avoid "reasoning" model lines (DeepSeek-R1*, GLM-Z1*) for chatTurn: tested
# and confirmed they leak visible chain-of-thought into the roleplay reply instead
# of answering in character. zai-org/GLM-4-9B-0414 has been tested and confirmed
# working cleanly for generateScenario/chatTurn/analyzeSession, at the 9B/1-unit
# concurrency tier (full 4 concurrent requests on the Chat plan).
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=zai-org/GLM-4-9B-0414
