DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leena"
PORT=4000

# AI_LLM_PROVIDER: "anthropic" (default) or "featherless"
AI_LLM_PROVIDER=anthropic
AI_SPEECH_PROVIDER=openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only needed when AI_LLM_PROVIDER=featherless. Get FEATHERLESS_API_KEY from
# https://featherless.ai. FEATHERLESS_MODEL must be an exact model id from
# their catalogue (e.g. "deepseek-ai/DeepSeek-R1-0528") -- check that model's
# concurrency-unit cost on its Featherless page before using it in a live demo,
# since larger models consume more of the plan's limited concurrent units.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
