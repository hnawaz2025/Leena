generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  deviceId                String                   @unique
  authToken               String                   @unique
  nativeLanguage          String
  targetLanguage          String
  createdAt               DateTime                 @default(now())
  documents               Document[]
  scenarios               Scenario[]
  sessions                Session[]
  translationAssistEvents TranslationAssistEvent[]
}

model Document {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  extractedText String
  storageUrl    String?
  createdAt     DateTime             @default(now())
  scenarios     Scenario[]
  explanation   DocumentExplanation?

  @@index([userId])
}

model DocumentExplanation {
  id          String   @id @default(uuid())
  documentId  String   @unique
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  summary     String
  keyTerms    Json
  actionItems Json
  createdAt   DateTime @default(now())
}

model Scenario {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId         String?
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title              String
  situationType      String    @default("")
  personaDescription String
  contextSummary     String
  language           String
  createdAt          DateTime  @default(now())
  sessions           Session[]

  @@index([userId])
  @@index([documentId])
}

model Session {
  id                      String                   @id @default(uuid())
  userId                  String
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId              String
  scenario                Scenario                 @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  startedAt               DateTime                 @default(now())
  endedAt                 DateTime?
  status                  String                   @default("active")
  turns                   Turn[]
  feedback                FeedbackReport?
  translationAssistEvents TranslationAssistEvent[]

  @@index([userId])
  @@index([scenarioId])
}

model Turn {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker   String
  text      String
  audioUrl  String?
  language  String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model FeedbackReport {
  id                        String   @id @default(uuid())
  sessionId                 String   @unique
  session                   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary                   String
  summaryNative             String   @default("")
  struggleAreas             Json
  struggleAreasNative       Json     @default("[]")
  vocabularySuggestions     Json
  conversationSummary       String   @default("")
  conversationSummaryNative String   @default("")
  createdAt                 DateTime @default(now())
}

// Deliberately separate from Turn: a help-request must never leak into
// chatTurn's history or analyzeSession's transcript. Kept for a future
// WHOOP-style metrics dashboard (usage patterns, e.g. "used help mostly on
// medical vocabulary"), not consumed by anything yet.
model TranslationAssistEvent {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nativeLanguage     String
  nativeLanguageText String
  suggestedText      String
  wasUsed            Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}
