generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  deviceId                String                   @unique
  authToken               String                   @unique
  nativeLanguage          String
  targetLanguage          String
  createdAt               DateTime                 @default(now())
  documents               Document[]
  scenarios               Scenario[]
  sessions                Session[]
  translationAssistEvents TranslationAssistEvent[]
  phrasePracticeEvents    PhrasePracticeEvent[]
}

model Document {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  extractedText String
  createdAt     DateTime             @default(now())
  scenarios     Scenario[]
  explanation   DocumentExplanation?

  @@index([userId])
}

model DocumentExplanation {
  id          String   @id @default(uuid())
  documentId  String   @unique
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  summary     String
  keyTerms    Json
  actionItems Json
  createdAt   DateTime @default(now())
}

model Scenario {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId         String?
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title              String
  situationType      String    @default("")
  personaDescription String
  contextSummary     String
  language           String
  // The things this conversation demands, as [{ en, native }]. Generated once
  // at the first session end and never rewritten -- coverage can only
  // accumulate against a target that doesn't move between attempts.
  checklist          Json?
  createdAt          DateTime  @default(now())
  sessions           Session[]

  @@index([userId])
  @@index([documentId])
}

model Session {
  id                      String                   @id @default(uuid())
  userId                  String
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId              String
  scenario                Scenario                 @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  startedAt               DateTime                 @default(now())
  endedAt                 DateTime?
  status                  String                   @default("active")
  turns                   Turn[]
  feedback                FeedbackReport?
  translationAssistEvents TranslationAssistEvent[]

  @@index([userId])
  @@index([scenarioId])
}

model Turn {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker        String
  text           String
  language       String
  // True when this turn started life as a "Help me say this" suggestion.
  // Recorded at write time rather than inferred later: the user can edit a
  // suggestion before sending it, so matching the text afterwards would credit
  // them for a sentence the app wrote -- exactly backwards for a feature meant
  // to counter underestimating themselves.
  fromSuggestion Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([sessionId])
}

model FeedbackReport {
  id                        String   @id @default(uuid())
  sessionId                 String   @unique
  session                   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary                   String
  summaryNative             String   @default("")
  vocabularySuggestions     Json
  conversationSummary       String   @default("")
  conversationSummaryNative String   @default("")
  // Indices into the scenario's checklist that this session covered. Stored
  // per session and append-only; total coverage is derived by unioning across
  // the scenario's reports, which keeps "new this time" recoverable.
  coveredIndices            Json     @default("[]")
  // Indices into the session's turns (not the checklist). LLM-tagged at
  // session end: turns that dodged a question, and turns that asked for
  // repetition or explanation. The second is deliberately kept apart -- asking
  // for clarification is engagement, and must never be scored as a dodge.
  nonAnswerTurnIndices      Json     @default("[]")
  clarificationTurnIndices  Json     @default("[]")
  createdAt                 DateTime @default(now())
}

// Why the user got stuck. Tagged on every help request so recurring
// patterns are countable across scenarios later ("mostly formality") rather
// than being uniquely-worded freeform strings. Nothing consumes this yet --
// it's collected now so the pattern layer has history to work with.
enum StruggleCategory {
  VOCABULARY // didn't know a specific word/phrase
  GRAMMAR // tense, sentence structure
  CONFIDENCE // hesitation, incomplete answers
  COMPREHENSION // misunderstood the other party
  FORMALITY // wrong register/tone for the situation
  DOMAIN_KNOWLEDGE // didn't understand a concept, not just a word
}

// Deliberately separate from Turn: a help-request must never leak into
// chatTurn's history or analyzeSession's transcript.
//
// sessionId is optional on purpose. Set = the user got stuck mid-rehearsal;
// null = they hit the quick-lookup button in real life. Same kind of event
// either way ("I didn't know how to say this"), so one table keeps the
// cross-cutting question -- what does this person keep getting stuck on,
// wherever it happened -- a single query.
model TranslationAssistEvent {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          String?
  // SetNull, not Cascade: deleting a scenario must not destroy phrases the
  // user learned while practising it. The phrase outlives the session it came
  // from and simply stops being attributable to one.
  session            Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  nativeLanguage     String
  nativeLanguageText String
  suggestedText      String
  // Normalized English phrase (lowercased, no trailing punctuation) -- the
  // key the phrasebook groups on, so looking the same thing up five times
  // collapses to one entry with a count instead of five rows of noise.
  keyPhrase          String            @default("")
  category           StruggleCategory?
  // Self-reported "I actually said this", set by POST /help/:eventId/use when
  // the user taps "Use this" mid-rehearsal or "I said it" after a real-world
  // lookup. Write-only today: nothing reads it yet. Kept because it is the
  // only signal separating a phrase that got spoken from one that was merely
  // looked at, which is what a "phrases you've actually used" view would need.
  wasUsed            Boolean           @default(false)
  createdAt          DateTime          @default(now())

  @@index([userId])
  @@index([sessionId])
}

// Tapping the speaker icon to hear a phrase said aloud. An append-only log,
// same pattern as TranslationAssistEvent, rather than a mutable counter --
// the count is derived from it, and the timestamps are what a future
// spaced-repetition reminder ("haven't practiced this in 10 days") would
// actually need, not just a total.
model PhrasePracticeEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPhrase String
  createdAt DateTime @default(now())

  @@index([userId])
}
