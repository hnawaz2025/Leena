{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["src"],
  // Tests run from source via tsx, so they never need compiling -- and
  // shipping them to the server would put test fixtures in the deployed image.
  "exclude": ["src/**/*.test.ts"]
}
